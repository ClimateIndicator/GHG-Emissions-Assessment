# 1970s
# 1980s
# 1990s
# 2000s
# 2010s
# 2023
# 2024
data_table <- data_ghg %>%
mutate(cut=ifelse(year>=1970 & year <=1979,"1970-1979",NA)) %>%
mutate(cut=ifelse(year>=1980 & year <=1989,"1980-1989",cut)) %>%
mutate(cut=ifelse(year>=1990 & year <=1999,"1990-1999",cut)) %>%
mutate(cut=ifelse(year>=2000 & year <=2009,"2000-2009",cut)) %>%
mutate(cut=ifelse(year>=2014 & year <=2023,"2014-2023",cut))
data_table_ghgs <- data_table
data_table <- data_table %>%
filter(!is.na(cut)) %>%
group_by(label,cut) %>%
summarise(value=mean(value))
## add a 2010-2019 column
data_table_2010 <- data_ghg %>%
mutate(cut=ifelse(year>=2010 & year <=2019,"2010-2019",NA)) %>%
filter(!is.na(cut)) %>%
group_by(label,cut) %>%
summarise(value=mean(value))
data_table <- rbind(data_table,data_table_2010)
## add the 2023 data
data_table <- rbind(data_table,data_ghg %>%
ungroup() %>%
filter(year==2023) %>%
rename(cut=year) %>%
mutate(cut=as.character(cut)) %>%
select(label,cut,value))
## calculate uncertainties
uncertainties = data.frame(label=c("CO2-FFI","CO2-LULUCF","CH4","N2O","F-gases"),uncertainty=c(0.08,0.7,0.3,0.6,0.3))
data_table <- left_join(data_table,uncertainties,by="label")
data_table <- data_table %>%
mutate(uncertainty_abs=value*uncertainty) %>%
#mutate(value=ifelse(label %in% c("CO2-FFI"),signif(value,3),signif(value,2))) %>%
mutate(value=round(value,1)) %>%
#mutate(uncertainty_abs=signif(uncertainty_abs,2)) %>%
mutate(uncertainty_abs=round(uncertainty_abs,1))
data_table <- data_table %>%
mutate(value=paste0(value,"±",uncertainty_abs))
## calculate total GHGs
data_table_ghgs <- rbind(data_table_ghgs,data_ghg %>%
filter(year==2023) %>%
mutate(cut="2023"))
data_table_ghgs <- rbind(data_table_ghgs,data_table_ghgs %>%
filter(year>=2010) %>%
filter(year<=2019) %>%
mutate(cut="2010-2019")) %>%
filter(!is.na(cut))
data_table_ghgs <- left_join(data_table_ghgs,uncertainties,by="label")
data_table_ghgs <- data_table_ghgs %>%
group_by(cut,label,uncertainty) %>%
summarise(value=mean(value,na.rm=TRUE))
data_table_ghgs <- data_table_ghgs %>%
mutate(uncertainty_abs=value*uncertainty) %>%
mutate(uncertainty_abs=uncertainty_abs^2) %>%
filter(!is.na(cut)) %>%
group_by(cut) %>%
summarise(value=sum(value,na.rm=TRUE),
uncertainty_abs=sqrt(sum(uncertainty_abs,na.rm=TRUE)))
data_table_ghgs <- data_table_ghgs %>%
mutate(label="GHG") %>%
#mutate(value=signif(value,3)) %>%
mutate(value=round(value,1)) %>%
#mutate(uncertainty_abs=signif(uncertainty_abs,2)) %>%
mutate(uncertainty_abs=round(uncertainty_abs,1)) %>%
mutate(value=paste0(value,"±",uncertainty_abs))
data_table <- rbind(data_table,data_table_ghgs)
data_table <- data_table %>%
select(-uncertainty,-uncertainty_abs)
## add GCB projections
data_table <- data_table %>%
ungroup() %>%
add_row(label="CO2-FFI",cut="2024 (projection)",value="38.1±3") %>%
add_row(label="CO2-LULUCF",cut="2024 (projection)",value="4.4±3.1")
# round(10.4*3.664,1)
# (10.4*3.664)*0.08
#
# round(1.2*3.664,1)
# (1.2*3.664)*0.7
data_table$label <- as.factor(data_table$label)
data_table$label <- fct_relevel(data_table$label,"GHG","CO2-FFI","CO2-LULUCF","CH4","N2O","F-gases")
data_table <- spread(data_table,cut,value)
write.xlsx(data_table,'results/section_2_2_table_2025.xlsx')
write.csv(data_table,'results/section_2_2_table_2025.csv',row.names = FALSE)
write.csv(spread(data_ghg %>%
ungroup() %>%
select(-var,-source),label,value),'results/ghg_emissions_co2e_2025.csv',row.names = FALSE)
metadata <- data_ghg %>%
filter(year==2020) %>%
select(gas=label,source,units_co2e=units) %>%
mutate(units_original=ifelse(source!="PRIMAP v2.4.2*",units_co2e,"MtCH4")) %>%
mutate(units_original=ifelse(gas=="N2O","MtN2O",units_original))
metadata$source <- gsub("\\*","",metadata$source)
wb <- createWorkbook()
addWorksheet(wb,"metadata")
addWorksheet(wb,"data_co2e")
writeData(wb,"metadata",metadata, colNames = T, rowNames = F)
writeData(wb,"data_co2e",spread(data_ghg %>% ungroup %>% select(-var,-source,-units,-gwp),label,value), colNames = T, rowNames = F)
### add a sheet with the data in original units
data_ghg_original <- rbind(data_gcb_co2_ffi,data_gcb_co2_luc %>% filter(grepl("\\*",source)))
data_ghg_original <- rbind(data_ghg_original,data_primap_tp_ch4 %>% filter(sector=="M.0.EL") %>% select(-sector))
data_ghg_original <- rbind(data_ghg_original,data_primap_tp_n2o %>% filter(sector=="M.0.EL") %>% select(-sector))
data_ghg_original <- rbind(data_ghg_original,data_inversions_fgases %>% filter(grepl("UNFCCC",source)))
data_ghg_original <- left_join(data_ghg_original,data_ghg %>% ungroup() %>% select(var,label) %>% distinct(),by="var")
data_ghg_original <- data_ghg_original %>%
select(label,source,units,year,value)
addWorksheet(wb,"data_original_units")
writeData(wb,"data_original_units",data_ghg_original, colNames = T, rowNames = F)
## add a sheet with all the other sources
# addWorksheet(wb,"data_all_sources")
# writeData(wb,"data_all_sources",left_join(data,data_ghg %>% select(var,label) %>% distinct(),by="var") %>%
#   select(year,gas=label,source,units,value), colNames = T, rowNames = F)
saveWorkbook(wb,'results/ghg_emissions_co2e_2025.xlsx',overwrite=T)
data_2025 <- data
data_ghg_2025 <- data_ghg
save(data_2025,data_ghg_2025,file="results/data/data_2025.RData")
## Gather data for each assessment convention
data_conventions <- rbind(
data %>%
filter(grepl("\\*",source)) %>%
mutate(convention = "WGIII update"),
data %>%
filter(grepl("\\*",source) | grepl("cement",source) | grepl("ODS",source) | grepl("GFED",source)) %>%
mutate(convention = "WGIII update + additional sources"),
data %>%
filter(grepl("PRIMAP CR",source) | grepl("Grassi",source)) %>%
mutate(convention = "Inventory-aligned")) %>%
filter(year==2023)
## Calculate gwp100 emissions
data_conventions <- data_conventions %>%
mutate(gwp=ifelse(var=="ch4",gwps$AR6GWP100[gwps$Species=="CH4"],1)) %>%
mutate(gwp=ifelse(var=="n2o",gwps$AR6GWP100[gwps$Species=="N2O"],gwp)) %>%
mutate(value_gwp=value*gwp) %>%
mutate(value_gwp=ifelse(var %in% c("ch4","n2o"),value_gwp/1000,value_gwp))
data_conventions <- data_conventions %>%
mutate(value=value_gwp) %>%
select(-value_gwp,-gwp)
data_conventions <- data_conventions %>%
mutate(component=ifelse(grepl("ODS",source),"ODS F-gases",NA)) %>%
mutate(component=ifelse(grepl("GFED",source),"Fires (CH4 & N2O)",component)) %>%
mutate(component=ifelse(grepl("cement",source),"Cement carbonation",component)) %>%
mutate(component=ifelse(var=="co2_luc","Land use change (LULUCF)",component)) %>%
mutate(component=ifelse(is.na(component),"Energy, Industrial Processes, Agriculture & Waste",component))
## Save data
#removeWorksheet(wb,"ghg_luc")
# addWorksheet(wb,"fig13_ghg_conventions")
# writeData(wb, sheet = "fig13_ghg_conventions",data_plot,colNames = T, rowNames = F)
## Calculate emissions in 2023
data_conventions_totals <- data_conventions  %>%
left_join(.,data.frame(var=c("co2_ffi","ch4","n2o","fgases","co2_luc"),
uncertainty=c(0.08,0.3,0.6,0.3,0.7)),by=join_by(var)) %>%
mutate(uncertainty_abs=value*uncertainty) %>%
mutate(uncertainty_abs=uncertainty_abs^2) %>%
group_by(convention) %>%
summarise(value=sum(value,na.rm=TRUE),
uncertainty_abs=sqrt(sum(uncertainty_abs,na.rm=TRUE))) %>%
mutate(label = paste0(signif(value,3)," ± ",signif(uncertainty_abs,2)))
data_conventions <- data_conventions %>%
group_by(convention,component) %>%
summarise(value=sum(value))
data_conventions$component <- as.factor(data_conventions$component)
data_conventions$component <- fct_relevel(data_conventions$component,
"ODS F-gases",
"Fires (CH4 & N2O)",
"Energy, Industrial Processes, Agriculture & Waste",
"Land use change (LULUCF)",
"Cement carbonation")
data_conventions$convention <- as.factor(data_conventions$convention)
data_conventions$convention <- fct_relevel(data_conventions$convention,
"Inventory-aligned",
"WGIII update + additional sources",
"WGIII update")
plot <- data_conventions %>% ggplot(.,aes(x=value,y=convention,fill=component)) +
geom_col(color="#252525",linewidth=0.25) +
geom_errorbarh(data=data_conventions_totals,inherit.aes=FALSE,aes(xmin=value-uncertainty_abs,xmax=value+uncertainty_abs,y=convention),
height=0.4,colour="#525252") +
geom_text(data=data_conventions_totals,inherit.aes=FALSE,aes(x=value+uncertainty_abs+1,y=convention,label=label),
hjust=0,size=3.5,colour="#636363") +
theme_wl() +
scale_y_discrete(labels = function(x) str_wrap(x, width = 25)) +
scale_fill_manual(values=c("Energy, Industrial Processes, Agriculture & Waste"="#659cccff",
"Land use change (LULUCF)"="#7dd396ff",
"Cement carbonation"="#e5b82cff",
"ODS F-gases"="#9467bdff",
"Fires (CH4 & N2O)"="#ff9055ff")) +
scale_x_continuous(expand = expansion(mult = c(0.05, 0.22))) +
theme(axis.title = element_blank(),
legend.title = element_blank(),
panel.grid.major.y = element_blank()) +
labs(subtitle=bquote("Gt" ~CO[2]* "e in 2023"))
plot
## Save figure
#
ggsave(plot,filename = "plot_emissions_differences_2025.png",path = "results/",device = "png",height = 2.5,width=8,dpi=300)
ggsave(plot,filename = "plot_emissions_differences_2025.pdf",path = "results/",device = cairo_pdf,height = 2.5,width=8)
ggsave(plot,filename = "plot_emissions_differences_2025.svg",path = "results/",device = 'svg',height = 2.5,width=8)
