#   select(source,sector_lv1,var,units,year,value)
## Join to PRIMAP data
data_plot <- data %>%
filter(grepl("PRIMAP",source)) %>%
bind_rows(.,data_fao) %>%
filter(sector_lv1 %in% c(4)) %>%
group_by(source,var,units,year) %>%
summarise(value=sum(value,na.rm=TRUE))
## Add GCB
data_plot <- data_plot %>%
rbind(.,data_sectors %>%
filter(grepl("GCB",source)) %>%
mutate(var=toupper(var)) %>%
filter(var=="CO2_LUC") %>%
mutate(var="CO2") %>%
group_by(source,var,units,year) %>%
summarise(value=sum(value))) %>%
filter(year>=1990)
## Add JRC-NGHGI
data_nghgi <- data_sectors %>%
filter(grepl("JRC-NGHGI",source)) %>%
mutate(var=toupper(var)) %>%
filter(var=="CO2_LUC") %>%
mutate(var="CO2") %>%
group_by(source,var,units,year) %>%
summarise(value=sum(value))
data_plot <- data_plot %>%
rbind(.,data_nghgi)
## Save data
#removeWorksheet(wb,"ghg_luc")
addWorksheet(wb,"fig13_ghg_luc")
writeData(wb, sheet = "fig13_ghg_luc",data_plot,colNames = T, rowNames = F)
## Calculate 10 year average
data_plot <- data_plot %>%
filter(year>=2013) %>%
filter(year<=2022) %>%
group_by(source,var,units) %>%
summarise(value=sum(value)/10)
# Calculate totals and uncertainty ranges
data_plot_totals <- data_plot  %>%
left_join(.,data.frame(var=c("CO2","CH4","N2O"),
uncertainty=c(0.7,0.3,0.6)),by=join_by(var)) %>%
mutate(uncertainty_abs=value*uncertainty) %>%
mutate(uncertainty_abs=uncertainty_abs^2) %>%
group_by(source) %>%
summarise(value=sum(value,na.rm=TRUE),
uncertainty_abs=sqrt(sum(uncertainty_abs,na.rm=TRUE))) %>%
mutate(label = paste0(signif(value,3)," ± ",signif(uncertainty_abs,2)))
## Arrange factors
data_plot$var <- as.factor(data_plot$var)
data_plot$var <- fct_relevel(data_plot$var,"CO2","CH4","N2O")
## Plot
plot <- data_plot %>% ggplot(.,aes(x=value,y=source,fill=var)) +
geom_col(color="#252525",linewidth=0.25) +
geom_errorbarh(data=data_plot_totals,inherit.aes=FALSE,aes(xmin=value-uncertainty_abs,xmax=value+uncertainty_abs,y=source),
height=0.4,colour="#525252") +
geom_text(data=data_plot_totals,inherit.aes=FALSE,
aes(x=ifelse(value>0,value+uncertainty_abs+0.25,value-uncertainty_abs-0.25),y=source,label=label,hjust=ifelse(value>0,0,1)),
size=3.5,colour="#636363") +
theme_wl() +
scale_fill_manual(values=c("CO2"="#7dd396ff",
"CH4"="#659cccff",
"N2O"="#e5b82cff")) +
scale_x_continuous(breaks=c(-6,-4,-2,0,2,4,6),expand = expansion(mult = c(0.17, 0.16))) +
theme(axis.title = element_blank(),
legend.title = element_blank(),
panel.grid.major.y = element_blank())+
labs(title=bquote("Total LULUCF emissions"),subtitle=bquote("Average annual Gt" ~CO[2]* "e, 2013-2022"))
plot
ggsave(plot,filename = "ghg_differences_ghg_luc_2026.png",path = "results/",device = "png",height = 3.5,width=8,dpi=300)
ggsave(plot,filename = "ghg_differences_ghg_luc_2026.pdf",path = "results/",device = cairo_pdf,height = 3.5,width=8)
ggsave(plot,filename = "ghg_differences_ghg_luc_2026.svg",path = "results/",device = 'svg',height = 3.5,width=8)
## Get PRIMAP Hist-CR + Grassi NGHGI data
data_inventories <- data %>%
filter(grepl("PRIMAP CR",source)) %>%
filter(sector_lv1 %in% c(1,2,3,5,6)) %>%
group_by(source,var,year) %>%
summarise(value=sum(value,na.rm=TRUE)) %>%
mutate(component="Energy, IPPU, Agriculture & Waste")
data_inventories <- data_inventories %>%
bind_rows(.,data_nghgi %>% select(source,year,value) %>%
mutate(component="Land use change (LULUCF)") %>%
mutate(var="CO2")) %>%
ungroup() %>%
filter(year>=1990) %>%
mutate(convention="Inventory-aligned emissions") %>%
select(convention,component,var,year,value)
## Get GCB + PRIMAP Hist-TP
data_models <- data_sectors %>%
filter(grepl("GCB",source)) %>%
filter(!grepl("cement",source)) %>%
mutate(var=toupper(var)) %>%
mutate(component=ifelse(var=="CO2_LUC","Land use change (LULUCF)","Energy, IPPU, Agriculture & Waste")) %>%
select(source,component,var,year,value)
data_models <- data_models %>%
bind_rows(.,data %>%
filter(grepl("PRIMAP TP",source)) %>%
filter(sector_lv1 %in% c(1,2,3,5,6)) %>%
filter(var!="CO2") %>%
group_by(source,var,year) %>%
summarise(value=sum(value,na.rm=TRUE)) %>%
mutate(component="Energy, IPPU, Agriculture & Waste"))
data_models <- data_models %>%
filter(year>=1990) %>%
mutate(convention="IAM benchmark-aligned emissions") %>%
group_by(convention,component,var,year) %>%
summarise(value=sum(value))
## Get GCB + PRIMAP Hist-TP + cement carbonation + ODS Fgases + Fires
data_climate <- data_sectors %>%
filter(grepl("GCB",source)) %>%
mutate(component=ifelse(grepl("cement",source),"Cement carbonation","Energy, IPPU, Agriculture & Waste")) %>%
mutate(component=ifelse(var=="co2_luc","Land use change (LULUCF)",component)) %>%
mutate(var=toupper(var)) %>%
select(source,component,var,year,value)
data_climate <- data_climate %>%
bind_rows(.,data %>%
filter(grepl("PRIMAP TP",source)) %>%
filter(sector_lv1 %in% c(1,2,3,5,6)) %>%
filter(var!="CO2") %>%
group_by(source,var,year) %>%
summarise(value=sum(value,na.rm=TRUE)) %>%
mutate(component="Energy, IPPU, Agriculture & Waste"))
data_climate <- data_climate %>%
bind_rows(.,data_sectors %>%
filter(grepl("ODS",source)) %>%
mutate(component="ODS F-gases") %>%
mutate(var="FGASES"))
data_climate <- data_climate %>%
bind_rows(.,data_sectors %>%
filter(grepl("GFED",source)) %>%
mutate(component="Fires (CH4 & N2O)") %>%
mutate(value=ifelse(var=="ch4",value*gwps$AR6GWP100[gwps$var=="CH4"]/1000,value)) %>%
mutate(value=ifelse(var=="n2o",value*gwps$AR6GWP100[gwps$var=="N2O"]/1000,value)) %>%
mutate(var=toupper(var)))
data_climate <- data_climate %>%
filter(year>=1990) %>%
mutate(convention="IAM benchmark-aligned emissions + Additional sources") %>%
group_by(convention,component,var,year) %>%
summarise(value=sum(value))
data_plot <- rbind(data_inventories,data_models,data_climate)
data_plot_years <- data_plot
## Save data
#removeWorksheet(wb,"ghg_luc")
addWorksheet(wb,"fig14_ghg_conventions")
writeData(wb, sheet = "fig14_ghg_conventions",data_plot,colNames = T, rowNames = F)
## Calculate 10 year average
data_plot <- data_plot %>%
filter(year>=2014) %>%
filter(year<=2023) %>%
group_by(convention,component,var) %>%
summarise(value=sum(value)/10)
data_plot_totals <- data_plot  %>%
left_join(.,data.frame(var=c("CO2","CH4","N2O","FGASES"),
uncertainty=c(0.08,0.3,0.6,0.3)),by=join_by(var)) %>%
mutate(uncertainty=ifelse(component=="Land use change (LULUCF)" & var %in% c("CO2","CO2_LUC"),0.7,uncertainty)) %>%
mutate(uncertainty_abs=value*uncertainty) %>%
mutate(uncertainty_abs=uncertainty_abs^2) %>%
group_by(convention) %>%
summarise(value=sum(value,na.rm=TRUE),
uncertainty_abs=sqrt(sum(uncertainty_abs,na.rm=TRUE))) %>%
mutate(label = paste0(signif(value,3)," ± ",signif(uncertainty_abs,2)))
data_plot <- data_plot %>%
group_by(convention,component) %>%
summarise(value=sum(value))
data_plot$component <- as.factor(data_plot$component)
data_plot$component <- fct_relevel(data_plot$component,
"ODS F-gases",
"Fires (CH4 & N2O)",
"Energy, IPPU, Agriculture & Waste",
"Land use change (LULUCF)",
"Cement carbonation")
data_plot$convention <- as.factor(data_plot$convention)
data_plot$convention <- fct_relevel(data_plot$convention,
"IAM benchmark-aligned emissions + Additional sources",
"IAM benchmark-aligned emissions",
"Inventory-aligned emissions")
plot <- data_plot %>% ggplot(.,aes(x=value,y=convention,fill=component)) +
geom_col(color="#252525",linewidth=0.25) +
geom_errorbarh(data=data_plot_totals,inherit.aes=FALSE,aes(xmin=value-uncertainty_abs,xmax=value+uncertainty_abs,y=convention),
height=0.4,colour="#525252") +
geom_text(data=data_plot_totals,inherit.aes=FALSE,aes(x=value+uncertainty_abs+1,y=convention,label=label),
hjust=0,size=3.5,colour="#636363") +
theme_wl() +
scale_y_discrete(labels = function(x) str_wrap(x, width = 25)) +
scale_fill_manual(values=c("Energy, IPPU, Agriculture & Waste"="#659cccff",
"Land use change (LULUCF)"="#7dd396ff",
"Cement carbonation"="#e5b82cff",
"ODS F-gases"="#9467bdff",
"Fires (CH4 & N2O)"="#ff9055ff")) +
scale_x_continuous(expand = expansion(mult = c(0.05, 0.22))) +
theme(axis.title = element_blank(),
legend.title = element_blank(),
panel.grid.major.y = element_blank()) +
labs(title=bquote("Differences in total greenhouse gas emissions"),subtitle=bquote("Average annual Gt" ~CO[2]* "e, 2014-2023"))
plot
## Save figure
ggsave(plot,filename = "ghg_differences_ghg_conventions_2026.png",path = "results/",device = "png",height = 3,width=8,dpi=300)
ggsave(plot,filename = "ghg_differences_ghg_conventions_2026.pdf",path = "results/",device = cairo_pdf,height = 3,width=8)
ggsave(plot,filename = "ghg_differences_ghg_conventions_2026.svg",path = "results/",device = 'svg',height = 3,width=8)
data_plot <- data_sectors %>%
filter(grepl("GFED",source)) %>%
mutate(value=ifelse(var=="ch4",value*27.90,value*273.00)) %>%
mutate(value=value/1000) %>%
mutate(var=toupper(var)) %>%
filter(year>1999)
plot <- data_plot %>% ggplot(.,aes(x=year,y=value,fill=var)) +
geom_col(color="#252525",linewidth=0.25) +
theme_wl_bar_trend() +
scale_fill_manual(values=c("CH4"="#659cccff",
"N2O"="#e5b82cff")) +
theme(axis.title=element_blank()) +
labs(title=bquote("Total methane and nitrous oxide emissions from fires"),subtitle=bquote("Gt" ~CO[2]* "e")) +
scale_x_continuous(breaks=c(2000,2005,2010,2015,2020,2024))
plot
ggsave(plot,filename = "ghg_differences_total_fires.png",path = "results/",device = "png",height = 3,width=7,dpi=300)
ggsave(plot,filename = "ghg_differences_total_fires.png.pdf",path = "results/",device = cairo_pdf,height = 3,width=7)
ggsave(plot,filename = "ghg_differences_total_fires.png.svg",path = "results/",device = 'svg',height = 3,width=7)
saveWorkbook(wb,paste0("results/ghg_differences_2026.xlsx"),overwrite=T)
