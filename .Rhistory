## Gather data for each assessment convention
data_conventions <- rbind(
data %>%
filter(grepl("\\*",source)) %>%
mutate(convention = "WGIII update"),
data %>%
filter(grepl("\\*",source) | grepl("cement",source) | grepl("ODS",source) | grepl("GFED",source)) %>%
mutate(convention = "WGIII update + additional sources & sinks"),
data %>%
filter(grepl("PRIMAP CR",source) | grepl("Grassi",source)) %>%
mutate(convention = "Inventory-aligned")) %>%
filter(year==2023)
## Calculate gwp100 emissions
data_conventions <- data_conventions %>%
mutate(gwp=ifelse(var=="ch4",gwps$AR6GWP100[gwps$Species=="CH4"],1)) %>%
mutate(gwp=ifelse(var=="n2o",gwps$AR6GWP100[gwps$Species=="N2O"],gwp)) %>%
mutate(value_gwp=value*gwp) %>%
mutate(value_gwp=ifelse(var %in% c("ch4","n2o"),value_gwp/1000,value_gwp))
data_conventions <- data_conventions %>%
mutate(value=value_gwp) %>%
select(-value_gwp,-gwp)
data_conventions <- data_conventions %>%
mutate(component=ifelse(grepl("ODS",source),"ODS F-gases",NA)) %>%
mutate(component=ifelse(grepl("GFED",source),"Fires (CH4 & N2O)",component)) %>%
mutate(component=ifelse(grepl("cement",source),"Cement carbonation",component)) %>%
mutate(component=ifelse(var=="co2_luc","Land use change (LULUCF)",component)) %>%
mutate(component=ifelse(is.na(component),"Energy, Industrial Processes, Agriculture & Waste",component))
## Save data
#removeWorksheet(wb,"ghg_luc")
# addWorksheet(wb,"fig13_ghg_conventions")
# writeData(wb, sheet = "fig13_ghg_conventions",data_plot,colNames = T, rowNames = F)
## Calculate emissions in 2023
data_conventions_totals <- data_conventions  %>%
left_join(.,data.frame(var=c("co2_ffi","ch4","n2o","fgases","co2_luc"),
uncertainty=c(0.08,0.3,0.6,0.3,0.7)),by=join_by(var)) %>%
mutate(uncertainty_abs=value*uncertainty) %>%
mutate(uncertainty_abs=uncertainty_abs^2) %>%
group_by(convention) %>%
summarise(value=sum(value,na.rm=TRUE),
uncertainty_abs=sqrt(sum(uncertainty_abs,na.rm=TRUE))) %>%
mutate(label = paste0(signif(value,3)," ± ",signif(uncertainty_abs,2)))
data_conventions <- data_conventions %>%
group_by(convention,component) %>%
summarise(value=sum(value))
data_conventions$component <- as.factor(data_conventions$component)
data_conventions$component <- fct_relevel(data_conventions$component,
"ODS F-gases",
"Fires (CH4 & N2O)",
"Energy, Industrial Processes, Agriculture & Waste",
"Land use change (LULUCF)",
"Cement carbonation")
data_conventions$convention <- as.factor(data_conventions$convention)
data_conventions$convention <- fct_relevel(data_conventions$convention,
"Inventory-aligned",
"WGIII update + additional sources & sinks",
"WGIII update")
plot <- data_conventions %>% ggplot(.,aes(x=value,y=convention,fill=component)) +
geom_col(color="#252525",linewidth=0.25) +
geom_errorbarh(data=data_conventions_totals,inherit.aes=FALSE,aes(xmin=value-uncertainty_abs,xmax=value+uncertainty_abs,y=convention),
height=0.4,colour="#525252") +
geom_text(data=data_conventions_totals,inherit.aes=FALSE,aes(x=value+uncertainty_abs+1,y=convention,label=label),
hjust=0,size=3.5,colour="#636363") +
theme_wl() +
scale_y_discrete(labels = function(x) str_wrap(x, width = 25)) +
scale_fill_manual(values=c("Energy, Industrial Processes, Agriculture & Waste"="#659cccff",
"Land use change (LULUCF)"="#7dd396ff",
"Cement carbonation"="#e5b82cff",
"ODS F-gases"="#9467bdff",
"Fires (CH4 & N2O)"="#ff9055ff")) +
scale_x_continuous(expand = expansion(mult = c(0.05, 0.22))) +
theme(axis.title = element_blank(),
legend.title = element_blank(),
panel.grid.major.y = element_blank()) +
labs(subtitle=bquote("Gt" ~CO[2]* "e in 2023"))
plot
## Save figure
#
ggsave(plot,filename = "plot_emissions_differences_2025.png",path = "results/",device = "png",height = 2.5,width=9,dpi=300)
ggsave(plot,filename = "plot_emissions_differences_2025.pdf",path = "results/",device = cairo_pdf,height = 2.5,width=9)
ggsave(plot,filename = "plot_emissions_differences_2025.svg",path = "results/",device = 'svg',height = 2.5,width=9)
