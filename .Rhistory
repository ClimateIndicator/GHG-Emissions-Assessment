## Get FAO data (https://www.fao.org/faostat/en/#data/GT)
#
data_fao <- read.csv("sources/FAO/Emissions_Totals_E_All_Data_NOFLAG_2025_10_08.csv")
data_fao <- gather(data_fao,year,value,Y1961:Y2050)
data_fao$year <- gsub("Y","",data_fao$year)
data_fao <- data_fao %>%
mutate(year=as.numeric(year)) %>%
filter(!year %in% c(2030,2050)) %>%
filter(Area=="World") %>%
filter(Source=="FAO TIER 1") %>%
mutate(sector=paste0(Item.Code," ",Item)) %>%
select(sector,var=Element,units=Unit,year,value)
data_fao <- data_fao %>%
filter(var %in% c("Emissions (CH4)","Emissions (N2O)","Emissions (CO2)")) %>%
mutate(var=ifelse(grepl("CH4",var),"CH4",var)) %>%
mutate(var=ifelse(grepl("N2O",var),"N2O",var)) %>%
mutate(var=ifelse(grepl("CO2",var),"CO2",var)) %>%
mutate(source="FAOSTAT v2025.10.08") %>%
left_join(.,read.xlsx("sources/dataset_sectors.xlsx",sheet="fao_2025"),by=join_by("sector"))
data_fao <- data_fao %>%
mutate(value=as.numeric(value)) %>%
mutate(value=value/1e6) %>%
mutate(value=ifelse(var=="CH4",value*gwps$AR6GWP100[gwps$var=="CH4"],value)) %>%
mutate(value=ifelse(var=="N2O",value*gwps$AR6GWP100[gwps$var=="N2O"],value)) %>%
mutate(units="GtCO2e")
## Get Grassi et al. NGHGI data
#
# data_nghgi <- read.xlsx("sources/Grassi NGHGI/LULUCF NGHGI data for UNEP 2024.xlsx",startRow=4)
