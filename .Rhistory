library(openxlsx)
library(patchwork)
library(countrycode)
library(fuzzyjoin)
source("https://raw.githubusercontent.com/lambwf/Codebase/main/figure_style.R")
gwps <- read.csv("https://raw.githubusercontent.com/openclimatedata/globalwarmingpotentials/main/globalwarmingpotentials.csv",skip = 10)
gwps <- gwps %>% select(gas=Species,gwp100=AR6GWP100)
load("results/data/data_sectors_2026.RData")
data_sectors$source <- gsub("\\*","",data_sectors$source)
data_sectors <- data_sectors %>% mutate(var=ifelse(var=="co2_ffi","co2",var))
wb <- createWorkbook()
addWorksheet(wb,"info")
info = data.frame(a=c("Author","Contact"),
b=c("William F. Lamb",
"william.lamb@pik-potsdam.de"))
writeData(wb, sheet = "info",info,colNames = F, rowNames = F)
data_edgar <- data_sectors %>%
filter(grepl("EDGAR",source)) %>%
left_join(.,read.xlsx("sources/dataset_sectors.xlsx",sheet="edgar_2025"),by=join_by("sector"))
data_ceds <- data_sectors %>%
filter(grepl("CEDS",source)) %>%
left_join(.,read.xlsx("sources/dataset_sectors.xlsx",sheet="ceds_2025"),by=join_by("sector"))
data_primap <- data_sectors %>%
filter(grepl("PRIMAP",source)) %>%
left_join(.,read.xlsx("sources/dataset_sectors.xlsx",sheet="primap_2025"),by=join_by("sector"))
data <- bind_rows(data_edgar,
data_ceds,
data_primap)
## remove non-relevant sectors
data <- data %>% filter(!is.na(sector_lv1) | !is.na(sector_lv2))
data$var <- toupper(data$var)
data$var <- as.factor(data$var)
data$var <- fct_relevel(data$var,"CO2","CH4","N2O","FGASES")
gwps <- read.csv("https://raw.githubusercontent.com/openclimatedata/globalwarmingpotentials/main/globalwarmingpotentials.csv",skip = 10) %>%
select(var=Species,AR6GWP100)
data <- data %>%
mutate(value=ifelse(var=="CH4",value*gwps$AR6GWP100[gwps$var=="CH4"]/1000,value)) %>%
mutate(value=ifelse(var=="N2O",value*gwps$AR6GWP100[gwps$var=="N2O"]/1000,value)) %>%
mutate(units="GtCO2e") %>%
mutate(year=as.numeric(year))
## Get datasets
data_plot <- data %>%
filter(grepl("PRIMAP",source) | grepl("EDGAR",source) | grepl("CEDS",source)) %>%
filter(sector_lv1 %in% c(1,2,3,5,6)) %>%
group_by(source,var,units,year) %>%
summarise(value=sum(value,na.rm=TRUE)) %>%
filter(year>=1990)
## Save data
#removeWorksheet(wb,"ghg_ex_luc")
addWorksheet(wb,"fig9_ghg_ex_luc")
writeData(wb, sheet = "fig9_ghg_ex_luc",data_plot,colNames = T, rowNames = F)
## Calculate 10 year average
data_plot <- data_plot %>%
filter(year>=2014) %>%
filter(year<=2023) %>%
group_by(source,var,units) %>%
summarise(value=sum(value,na.rm=TRUE)/10)
# Calculate totals and uncertainty ranges
data_plot_totals <- data_plot  %>%
left_join(.,data.frame(var=c("CO2","CH4","N2O","FGASES"),
uncertainty=c(0.08,0.3,0.6,0.3)),by=join_by(var)) %>%
mutate(uncertainty_abs=value*uncertainty) %>%
mutate(uncertainty_abs=uncertainty_abs^2) %>%
group_by(source) %>%
summarise(value=sum(value,na.rm=TRUE),
uncertainty_abs=sqrt(sum(uncertainty_abs,na.rm=TRUE))) %>%
mutate(label = paste0(signif(value,3)," ± ",signif(uncertainty_abs,2)))
## Sum gases and arrange levels
data_plot$var <- as.factor(data_plot$var)
data_plot$var <- fct_relevel(data_plot$var,"FGASES","N2O","CH4","CO2_FFI")
## Plot
plot <- data_plot %>%
ggplot(.,aes(x=value,y=source,fill=var)) +
geom_col(color="#252525",linewidth=0.25) +
geom_errorbarh(data=data_plot_totals,inherit.aes=FALSE,aes(xmin=value-uncertainty_abs,xmax=value+uncertainty_abs,y=source),
height=0.4,colour="#525252") +
geom_text(data=data_plot_totals,inherit.aes=FALSE,aes(x=value+uncertainty_abs+1,y=source,label=label),
hjust=0,size=3.5,colour="#636363") +
theme_wl() +
scale_fill_manual(values=c("CO2"="#ff9055ff",
"CH4"="#659cccff",
"N2O"="#e5b82cff",
"FGASES"="#17becfff"),guide = guide_legend(reverse = TRUE) ) +
scale_x_continuous(breaks=c(0,10,20,30,40,50,60),expand = expansion(mult = c(0.05, 0.16))) +
theme(axis.title = element_blank(),
legend.title = element_blank(),
panel.grid.major.y = element_blank())+
labs(title=bquote("Total Kyoto gas emissions, excluding LULUCF"),subtitle=bquote("Average annual Gt" ~CO[2]* "e, 2014-2023"))
plot
## Save figure
ggsave(plot,filename = "ghg_differences_ghg_ex_luc_2026.png",path = "results/",device = "png",height = 3,width=8,dpi=300)
ggsave(plot,filename = "ghg_differences_ghg_ex_luc_2026.pdf",path = "results/",device = cairo_pdf,height = 3,width=8)
ggsave(plot,filename = "ghg_differences_ghg_ex_luc_2026.svg",path = "results/",device = 'svg',height = 3,width=8)
# Get datasets
data_plot <- data %>%
filter(grepl("PRIMAP",source) | grepl("EDGAR",source) | grepl("CEDS",source)) %>%
filter(year>=1990) %>%
filter(var=="CO2") %>%
filter(sector_lv1 %in% c(1,2,3,5,6)) %>%
mutate(sector=sector_lv1_description) %>%
group_by(source,sector,units,year) %>%
summarise(value=sum(value,na.rm=TRUE))
## Add GCB
data_plot <- data_plot %>%
rbind(.,data_sectors %>%
filter(grepl("GCB",source)) %>%
filter(year>=1990) %>%
mutate(var=toupper(var)) %>%
filter(var!="CO2_LUC" & !grepl("cement",source)) %>%
mutate(sector="Sectors not given") %>%
group_by(source,sector,year) %>%
summarise(value=sum(value,na.rm=TRUE))) %>%
mutate(units="GtCO2")
## Save data
#removeWorksheet(wb,"co2_ex_luc")
addWorksheet(wb,"fig10_co2_ex_luc")
writeData(wb, sheet = "fig10_co2_ex_luc",data_plot,colNames = T, rowNames = F)
## Calculate 10 year average
data_plot <- data_plot %>%
filter(year>=2014) %>%
filter(year<=2023) %>%
group_by(source,sector,units) %>%
summarise(value=sum(value)/10)
## Arrange sector levels
data_plot$sector <- as.factor(data_plot$sector)
data_plot$sector <- fct_relevel(data_plot$sector,"Energy","Industrial processes (IPPU)","Agriculture","Waste","Sectors not given")
# Calculate totals and uncertainty ranges
data_plot_totals <- data_plot  %>%
group_by(source) %>%
summarise(value=sum(value,na.rm=TRUE)) %>%
mutate(uncertainty_abs=value*0.08) %>%
mutate(label = paste0(signif(value,3)," ± ",signif(uncertainty_abs,2)))
## Plot
plot <- data_plot %>% ggplot(.,aes(x=value,y=source,fill=sector)) +
geom_col(color="#252525",linewidth=0.25) +
geom_errorbarh(data=data_plot_totals,inherit.aes=FALSE,aes(xmin=value-uncertainty_abs,xmax=value+uncertainty_abs,y=source),
height=0.4,colour="#525252") +
geom_text(data=data_plot_totals,inherit.aes=FALSE,aes(x=value+uncertainty_abs+1,y=source,label=label),
hjust=0,size=3.5,colour="#636363") +
theme_wl() +
scale_fill_manual(values=c("Energy"="#659cccff",
"Industrial processes (IPPU)"="#e5b82cff",
"Agriculture"="#4f8455ff",
"Waste"="#818181ff",
"Sectors not given"="#9467bdff"
)) +
scale_x_continuous(breaks=c(0,10,20,30,40,50,60),expand = expansion(mult = c(0.05, 0.16))) +
theme(axis.title = element_blank(),
legend.title = element_blank(),
panel.grid.major.y = element_blank())+
labs(title=bquote("Total carbon dioxide emissions, excluding LULUCF"),subtitle=bquote("Average annual Gt" ~CO[2]* ", 2014-2023"))
plot
## Save figures
ggsave(plot,filename = "ghg_differences_co2_ex_luc_2026.png",path = "results/",device = "png",height = 3.5,width=8,dpi=300)
ggsave(plot,filename = "ghg_differences_co2_ex_luc_2026.pdf",path = "results/",device = cairo_pdf,height = 3.5,width=8)
ggsave(plot,filename = "ghg_differences_co2_ex_luc_2026.svg",path = "results/",device = 'svg',height = 3.5,width=8)
