plot.title.position = "plot",
plot.subtitle = element_text(size=11,hjust=0.09)) +
labs(title=bquote(bold("(e) Global" ~N[2]* "O emissions")),
subtitle=bquote("Mt" ~N[2]* "O"))
p_n2o_2 <- data_labels %>%
filter(var=="n2o") %>%
ggplot(.,aes(x=year,y=value,color=source,group=source,label=str_wrap(source,17))) +
geom_text_repel(
nudge_x      = 3.5,
direction    = "y",
hjust        = 0,
segment.size = 0.3,
point.size = NA,
size=3.25,
force=3
) +
theme_wl_empty() +
scale_x_continuous(limits=c(2023,2045),breaks=c(2023,2045),expand = c(0, 0)) +
scale_y_continuous(limits=c(0,14),breaks=c(0,2,4,6,8,10,12,14),expand = c(0, 0)) +
scale_color_manual(values=colors,drop=FALSE) +
expand_limits(x = 0, y = 0) +
theme(legend.position="none",
plot.margin = unit(c(0,0,0,0),"cm"))
p_n2o <- p_n2o_1 + p_n2o_2 + plot_layout(widths=c(4,2.1))
p_n2o
