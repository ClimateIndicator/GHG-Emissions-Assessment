data_fuels <- data_ceds_fuels %>%
rbind(.,data_edgar_fgases %>%
group_by(year,var) %>%
summarise(value=sum(value)) %>%
mutate(fuel_category="non-fossil"))
data_fuels <- data_ceds_fuels %>%
rbind(.,data_gcb_co2_luc %>% filter(source=="GCB v2024*") %>%  mutate(fuel_category="non-fossil") %>% select(-source,-units))
gwps <- read.csv("https://raw.githubusercontent.com/openclimatedata/globalwarmingpotentials/main/globalwarmingpotentials.csv",skip = 10)
data_fuels <- data_fuels %>%
filter(year>=1970) %>%
mutate(gwp=ifelse(var=="ch4",gwps$AR6GWP100[gwps$Species=="CH4"],1)) %>%
mutate(gwp=ifelse(var=="n2o",gwps$AR6GWP100[gwps$Species=="N2O"],gwp)) %>%
mutate(value_gwp=value*gwp) %>%
mutate(value_gwp=ifelse(var %in% c("ch4","n2o"),value_gwp/1000,value_gwp))
data_fuels <- data_fuels %>%
mutate(value=value_gwp) %>%
select(-value_gwp)
data_fuels <- data_fuels %>%
mutate(year=as.numeric(year))
data_fuels %>% filter(year>=1990) %>%
ggplot(.,aes(x=year,y=value,fill=fuel_category)) +
geom_col() +
theme_wl_bar_trend()
